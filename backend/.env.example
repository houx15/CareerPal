# Backend runtime configuration.
# Copy this file to backend/.env for local development.

CAREERPAL_ENVIRONMENT=local
CAREERPAL_DATABASE_URL=sqlite:///./careerpal.db
CAREERPAL_SECRET_KEY=change-me-in-production
CAREERPAL_ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM provider options: fake, openai, anthropic.
# Use openai for OpenAI-compatible APIs.
CAREERPAL_LLM_PROVIDER=fake
CAREERPAL_LLM_BASE_URL=
CAREERPAL_LLM_MODEL_NAME=careerpal-fake
CAREERPAL_LLM_API_KEY=

# Examples for real providers:
# CAREERPAL_LLM_PROVIDER=openai
# CAREERPAL_LLM_BASE_URL=https://api.openai.com/v1
# CAREERPAL_LLM_MODEL_NAME=gpt-4o-mini
# CAREERPAL_LLM_API_KEY=sk-...
#
# CAREERPAL_LLM_PROVIDER=anthropic
# CAREERPAL_LLM_BASE_URL=https://api.anthropic.com/v1
# CAREERPAL_LLM_MODEL_NAME=claude-3-5-sonnet-latest
# CAREERPAL_LLM_API_KEY=sk-ant-...

CAREERPAL_RESUME_STORAGE_DIR=./storage/resumes
CAREERPAL_RESUME_MAX_UPLOAD_BYTES=5242880

# JSON array parsed by pydantic-settings.
CAREERPAL_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001"]
